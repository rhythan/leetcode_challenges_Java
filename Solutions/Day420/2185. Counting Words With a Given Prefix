class Solution {
    public int prefixCount(String[] words, String pref) {
        int ans = 0 ;
        for(String s : words){
            if(check(s,pref)) ans++;
        }
        return ans;

        
    }
    boolean check(String str , String pref){
        int n = pref.length();
        if(n>str.length()) return false;
        String s = str.substring(0,n);
        return pref.equals(s);

    }
}
