class Solution {
    public int missingMultiple(int[] nums, int k) {
        Set<Integer> set = new HashSet<>();
        for(int num : nums){
            set.add(num);
        }
        int n = k;
        while(true){
            if(!set.contains(k)){
                return k;
            }
            k += n ;
        }
        
    }
}
