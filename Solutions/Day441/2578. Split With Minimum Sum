class Solution {
    public int splitNum(int num) {
        String str = String.valueOf(num);
        char[] arr = str.toCharArray();
        Arrays.sort(arr);
        String num1 = "";
        String num2 = "";
        for(int i = 0; i < arr.length; i++){
            if(i % 2 == 0){
                num1 += arr[i];
            }
            else{
                num2 += arr[i];
            }
        }
        return Integer.valueOf(num1) + Integer.valueOf(num2);
    }
}
