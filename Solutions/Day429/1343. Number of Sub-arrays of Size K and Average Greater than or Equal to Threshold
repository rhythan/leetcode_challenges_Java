class Solution {
    public int numOfSubarrays(int[] arr, int k, int threshold) {
        int sum = 0 , cnt = 0 ;
        for(int i = 0 ; i < k ; i ++){
            sum+=arr[i];
        }
        if(check(sum,k,threshold)) cnt++;
        for(int i = k ; i < arr.length ; i ++){
            sum-=arr[i-k];
            sum+= arr[i];
            if(check(sum,k,threshold)) cnt++;
        }
        return cnt;
    }
    public boolean check(int sum , int k , int threshold){
        return (sum/k)>=threshold;
    }
}
