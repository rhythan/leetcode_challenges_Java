        List<Integer> list = new ArrayList<>();
        int cnt = 0;
        for(int i = 0 ; i < arr.length ; i ++){
            if(arr[i]==0){
                list.add(0);
                list.add(0);
            }
            if(i<arr.length&&arr[i]!=0){
                list.add(arr[i]);
            }
        }
        for(int i = 0 ;i < arr.length ; i ++){
            arr[i]=list.get(i);
        }
       

