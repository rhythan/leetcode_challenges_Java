class Solution {
    public int garbageCollection(String[] garbage, int[] travel) {

        int[] prefixSum = new int[travel.length + 1];
        prefixSum[0] = 0;

        for (int i = 1; i < travel.length + 1; i++) {
            prefixSum[i] = prefixSum[i - 1] + travel[i - 1];
        }
        int lastM = 0;
        int lastP = 0;
        int lastG = 0;
        int total = 0;

        for (int i = 0; i < garbage.length; i++) {
            String str = garbage[i];
            total += str.length();
            if (str.indexOf('M') != -1)
                lastM = i;
            if (str.indexOf('P') != -1)
                lastP = i;
            if (str.indexOf('G') != -1)
                lastG = i;
        }

        return total + prefixSum[lastM] + prefixSum[lastP] + prefixSum[lastG];
    }
}
